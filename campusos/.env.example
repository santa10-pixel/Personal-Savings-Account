# Database Configuration (PostgreSQL for Production, SQLite for local dev)
DATABASE_URL=sqlite:///./campusos.db
# DATABASE_URL=postgresql://campusos:secret@localhost:5432/campusos

# Security & Authentication
SECRET_KEY=generate-a-strong-random-secret-key-here-for-production
JWT_SECRET_KEY=generate-a-strong-random-jwt-key-here-for-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# URLs & CORS
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Google Classroom OAuth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Teams / Graph OAuth (Optional)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# VIT Moodle LMS Token (Optional)
MOODLE_BASE_URL=https://lms.vit.ac.in
MOODLE_API_TOKEN=

# Email & Reminder Notifications (Resend / SMTP)
RESEND_API_KEY=
EMAIL_FROM=CampusOS Reminders <reminders@campusos.vit.ac.in>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Default Timezone
DEFAULT_TIMEZONE=Asia/Kolkata
